{
  "$schema": "../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": ".",
  "projects": {
    "desktop": {
      "projectType": "application",
      "root": ".",
      "sourceRoot": "src",
      "prefix": "bc",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/desktop",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "bc-iconfont.js",
                "input": "../packages/editor/assets/iconfont",
                "output": "assets/blockcraft-iconfont"
              }
            ],
            "styles": [
              "src/styles.scss",
              "../node_modules/@cses/ui/styles/cses-ui.scss",
              "../packages/editor/themes/base.scss",
              "../packages/editor/themes/light.scss",
              "../packages/editor/themes/dark.scss",
              "../packages/editor/assets/iconfont/bc-iconfont.css"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": true,
              "sourceMap": false
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "development": { "buildTarget": "desktop:build:development" },
            "production": { "buildTarget": "desktop:build:production" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    }
  }
}
