{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlockCraft Desktop",
  "version": "0.1.0",
  "identifier": "com.blockcraft.desktop",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "http://localhost:4201",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BlockCraft Desktop",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.svg"],
    "fileAssociations": [
      {
        "ext": ["bcdoc"],
        "mimeType": "application/x-blockcraft-document",
        "description": "BlockCraft Document",
        "role": "Editor"
      }
    ]
  }
}
